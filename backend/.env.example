# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
FRONTEND_URLS=https://your-frontend.vercel.app,https://*.vercel.app

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────────────────────────────
# Preferred in Render production:
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=false
# Optional explicit fields for local development or non-URL setups:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smissi
DB_USER=smissi
DB_PASSWORD=smissi_dev
# Set to "true" to auto-sync schema in dev only
DB_SYNC=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# ─── Redis (cache + queues) ───────────────────────────────────────────────────
# Preferred in Render production:
REDIS_URL=redis://default:password@host:6379
# Optional explicit fields for local development or non-URL setups:
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── File Uploads / Storage ───────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smissi-uploads
R2_PUBLIC_URL=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# ─── SMS ──────────────────────────────────────────────────────────────────────
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=SMISSI

# ─── Payments ─────────────────────────────────────────────────────────────────
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
APP_URL=http://localhost:3000
