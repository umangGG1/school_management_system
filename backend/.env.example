# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smissi
DB_USER=smissi
DB_PASSWORD=smissi_dev
# Set to "true" to auto-sync schema in dev (do NOT use in production)
DB_SYNC=true
# Connection pool — increase DB_POOL_MAX in production (recommended: 20)
DB_POOL_MAX=20
DB_POOL_MIN=2

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5174

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret-128-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-strong-secret-128-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─── Redis (caching & job queues) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── SMS (Africa's Talking) ───────────────────────────────────────────────────
# AT_API_KEY=your-africas-talking-api-key
# AT_USERNAME=sandbox
# AT_SENDER_ID=SMISSI

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@smissi.ac.ug
# SENDGRID_FROM_NAME=SMISSI School System

# ─── File Storage (AWS S3 / Cloudflare R2) ────────────────────────────────────
# S3_BUCKET=smissi-uploads
# S3_REGION=af-south-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smissi-uploads
R2_PUBLIC_URL=

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=SMISSI

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@smissi.ac.ug

# ─── Pesapal (Mobile Money Payments) ─────────────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_IPN_ID=
APP_URL=http://localhost:3000
